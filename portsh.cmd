echo(rem ---- unified driver ^(cmd^) -- el_drive with the interp executor + registry routing ------------------
echo(rem Replaces cmd-jit-runtime.txt's el_drive when the interp is present: CURFN==interp runs :interp
echo(rem IN-PROCESS ^(state persists^); any other label routes through the ILAM registry ^(an ILAM_^<lbl^>_body -^>
echo(rem interpret it; else the per-PC compiled files^). ICUR ^(which AST^) saves/restores through RS ^(RSI^<n^>^).
echo(rem CALLEE forms: K:^<idx^> closure ^(label from the record^), C:^<lbl^>, I:^<lbl^> ^(interp fn-value^), bare.
echo(rem PERFORMANCE SHAPE ^(all measured on the VM^): cmd `goto :label` scans the file forward-and-wraps, so
echo(rem a BACKWARD jump ^(any loop^) costs a full-file scan ^(~11ms here^) regardless of label position; `for /l`
echo(rem CANNOT break early ^(goto/exit /b leave the body but cmd counts out the whole range^); a parenthesized
echo(rem block is parsed ONCE and its iterations cost ~0.03ms. Hence the CHUNKED loop: a small fixed for /l
echo(rem whose body is flag-guarded -- the dispatch runs scan-free, finishing a chunk costs at most 1000 empty
echo(rem guard checks, and ONE backward goto per chunk amortizes the scan to ~0.01ms/dispatch. Rare arms
echo(rem ^(closure deref, apply spread, no-action^) call front helpers ^(a call-ee may goto freely^).
echo(:el_drive
echo(set "ELDONE="
echo(:eld_chunk
echo(for /l %%%%Z in ^(1,1,1000^) do if not defined ELDONE ^(
echo(  set "ACTION="
echo(  if "!CURFN!"=="interp" ^(call :interp^) else call "!CURFN!_pc!PC!.cmd"
echo(  if "!ACTION!"=="call" ^(
echo(    set "RSF!RSP!=!CURFN!" ^& set "RSC!RSP!=!RPC!" ^& set "RSB!RSP!=!FP!" ^& set "RSL!RSP!=!CLO!" ^& set "RSI!RSP!=!ICUR!"
echo(    set /a RSP+=1
echo(    set "FP=!NFP!" ^& set "PC=0" ^& set "CLO=" ^& set "ICUR="
echo(    set "ELD2=!CALLEE:~0,2!"
echo(    if "!ELD2!"=="K:" ^(call :eld_clo^) else if "!ELD2!"=="C:" ^(set "ELDL=!CALLEE:~2!"^) else if "!ELD2!"=="I:" ^(set "ELDL=!CALLEE:~2!"^) else set "ELDL=!CALLEE!"
echo(    set "CURFN=!ELDL!"
echo(    if defined OSRSKIP_!ELDL! ^(set "CURFN=interp" ^& set "ICUR=!ELDL!"^) else if not defined COMPILED_!ELDL! if defined ILAM_!ELDL!_body ^(
echo(      set "CURFN=interp" ^& set "ICUR=!ELDL!"
echo(      if defined PORTSH_OSRDIR if exist "!PORTSH_OSRDIR!\!ELDL!_pc0.cmd" ^(set "COMPILED_!ELDL!=1" ^& set "CURFN=!ELDL!" ^& set "ICUR="^)
echo(    ^)
echo(  ^) else if "!ACTION!"=="ret" ^(
echo(    if !RSP!==0 ^(set "ELDONE=1"^) else ^(
echo(      set /a RSP-=1
echo(      call set "FP=%%%%RSB!RSP!%%%%" ^& call set "CURFN=%%%%RSF!RSP!%%%%" ^& call set "PC=%%%%RSC!RSP!%%%%" ^& call set "CLO=%%%%RSL!RSP!%%%%" ^& call set "ICUR=%%%%RSI!RSP!%%%%"
echo(    ^)
echo(  ^) else if "!ACTION!"=="apply" ^(
echo(    set "RSF!RSP!=!CURFN!" ^& set "RSC!RSP!=!RPC!" ^& set "RSB!RSP!=!FP!" ^& set "RSL!RSP!=!CLO!" ^& set "RSI!RSP!=!ICUR!"
echo(    set /a RSP+=1
echo(    set "FP=!NFP!" ^& set "PC=0" ^& set "CLO=" ^& set "ICUR="
echo(    call :eld_apply_spread
echo(    set "ELD2=!CALLEE:~0,2!"
echo(    if "!ELD2!"=="K:" ^(call :eld_clo^) else if "!ELD2!"=="C:" ^(set "ELDL=!CALLEE:~2!"^) else if "!ELD2!"=="I:" ^(set "ELDL=!CALLEE:~2!"^) else set "ELDL=!CALLEE!"
echo(    set "CURFN=!ELDL!"
echo(    if defined OSRSKIP_!ELDL! ^(set "CURFN=interp" ^& set "ICUR=!ELDL!"^) else if not defined COMPILED_!ELDL! if defined ILAM_!ELDL!_body ^(
echo(      set "CURFN=interp" ^& set "ICUR=!ELDL!"
echo(      if defined PORTSH_OSRDIR if exist "!PORTSH_OSRDIR!\!ELDL!_pc0.cmd" ^(set "COMPILED_!ELDL!=1" ^& set "CURFN=!ELDL!" ^& set "ICUR="^)
echo(    ^)
echo(  ^) else if "!ACTION!"=="" call :eld_noaction
echo(  if "!CURFN!"=="HALT" set "ELDONE=1"

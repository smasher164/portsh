>"%PSDIR%\interp-cmd.cmd" (
echo(@echo off
echo(rem portsh — batch-hosted Lisp kernel ^(operative / vau core^), port of kernel.sh.
echo(rem FAST heap: cons cells live in variables CAR_^<i^>/CDR_^<i^> ^(O^(1^) read/write^),
echo(rem so there is NO setlocal anywhere in the eval chain ^(endlocal would revert
echo(rem the heap^). Recursion-safe locals use frame ids: a caller does
echo(rem `set /a ND=%%1+1 ^& call :fn !ND! args`, the callee's id is %%1, inputs are
echo(rem %%2.. ^(stable across sub-calls^), and any value held ACROSS a sub-call is
echo(rem stored as _%%1_name. Reader is iterative ^(mutates global SRC + parse stack^).
echo(rem MUST be CRLF ^(label lookup^) and uses goto-dispatch ^(values contain parens^).
echo(setlocal enabledelayedexpansion
echo(set "HN=0" ^& set "FID=0" ^& set "SP=0" ^& set "FREE_HEAD=NIL" ^& set "MARKGEN=0"
echo(rem file-backed heap dir ^(cells = %%HD%%\car^<i^>/cdr^<i^>^), inherited in-process by any compiled subs
echo(rem that touch the heap. %%RANDOM%% alone is NOT enough: it's seeded from the wall-clock SECOND, so two
echo(rem processes launched together ^(e.g. the front-end's fg interp + bg program warmer^) get the SAME
echo(rem sequence -^> same dir -^> shared/corrupted heap. mkdir is the atomic claim: it FAILS if the dir
echo(rem exists, and the loser retries with fresh entropy ^(centiseconds + an advanced RANDOM^).
echo(:hd_claim
echo(set "HD=ph_%%RANDOM%%%%TIME:~9,2%%%%RANDOM%%"
echo(set "HD=!HD:,=!"
echo(mkdir "!HD!" 2^>nul
echo(if errorlevel 1 goto hd_claim
echo(if not defined GC_THRESH set "GC_THRESH=150000"
echo(rem Four sentinel bytes stand in for the chars cmd's expansion phases eat or mangle
echo(rem inside string VALUES: 0x01='!' ^(delayed expansion eats it^), 0x02='%%' ^(percent
echo(rem phase^), 0x07='^^' ^(caret/escape^), 0x08='"' (the string delimiter -- encoded first
echo(rem so it can't break the later replaces^). Operators ^& ^| ^< ^> need NO sentinel: the
echo(rem source is read RAW via `set /p` ^(:readall^), which doesn't parse content, so all
echo(rem of !,%%,^^,",&,|,<,> survive together; we then encode in dependency order. They
echo(rem decode back to real chars only at I/O; the '"' delimiters are consumed by the
echo(rem reader and never reach output ^(portsh strings have no '"' escape). 0x01/0x07/0x08
echo(rem are baked in as literal bytes ^(build.sh //^) where a `call`-based
echo(rem inject would double a live '^^'; 0x02 is fetched here for the delayed %%-replaces.
echo(for /F "delims=" %%%%a in ^('forfiles /p "%%~dp0." /m "%%~nx0" /c "cmd /c echo 0x02"'^) do set "BANG2=%%%%a"
echo(for /F "delims=" %%%%a in ^('forfiles /p "%%~dp0." /m "%%~nx0" /c "cmd /c echo 0x08"'^) do set "BANG8=%%%%a"
echo(rem BANG/BANG7 = literal 0x01/0x07 vars ^(baked by build.sh^). Compiled subs reference
echo(rem !BANG!/!BANG2! to materialise a data '!'/'%%' that would otherwise be eaten by the
echo(rem delayed-expansion pass when the value reaches a `set`; they decode to '!'/'%%' at I/O.
echo(set "BANG="
echo(set "BANG7="
echo(rem LT/GT/AMP/PIPE = the cmd operators ^< ^> ^& ^| as vars ^(baked literally inside
echo(rem QUOTES, which protect them from tokenization at parse time^). Compiled subs
echo(rem reference !LT! etc. to place an operator into a value's text via delayed
echo(rem expansion ^(post-tokenization^), the only way a bare operator survives a `set`.
echo(set "LT=<"
echo(set "GT=>"
echo(set "AMP=&"
echo(set "PIPE=|"
echo(rem setup_global SKIPPED ^(vau env unused by the resumable interp; ~2.4s/boot^)
echo(call _consts.cmd
echo(if exist _consts_std.cmd call _consts_std.cmd
echo(
echo(rem Boot order: minimal prelude -^> baked-in payload ^(stdlib^) after the marker -^>
echo(rem file-arg program. MK is built from fragments so the literal never appears here
echo(rem ^(the self-scan would match the kernel, not the baked-in final-line marker^).
echo(rem Both payload and program go through :feedfile, which reads each line RAW with
echo(rem `set /p` and encodes ! %% ^^ " to sentinels -- the only way to keep all of
echo(rem !, operators, and " in one line (no for-var read mode does). Source then drains
echo(rem through :addsrc; the reader keeps only the current line in SRC so parsing is
echo(rem O^(n^), and the parse stack ^(ST_/SP/DEPTH^) persists across lines for multi-line
echo(rem forms.
echo(set "SP=0" ^& set "DEPTH=0"
echo(set "MK=__PORTSH"
echo(set "MK=!MK!_PAYLOAD__"
echo(set "MLINE=0"
echo(findstr /c:"!MK!" "%%~f0" ^>nul 2^>^&1 ^&^& for /f "delims=:" %%%%n in ^('findstr /n /c:"!MK!" "%%~f0"'^) do if "!MLINE!"=="0" set "MLINE=%%%%n"
echo(if not "%%MLINE%%"=="0" call :feedfile "%%~f0" %%MLINE%%
echo(rem capture user args ^(after the program path^) into PORTSH_ARGV_^<n^>/PORTSH_ARGC for ^(argv^),
echo(rem unless a front-end already did ^(env vars inherit into child processes^).
echo(if defined PORTSH_ARGC goto k_args_done
echo(if "%%~1"=="" goto k_args_done
echo(set "PORTSH_ARGC=0"
echo(:k_args
echo(if "%%~2"=="" goto k_args_done
echo(set "PORTSH_ARGV_!PORTSH_ARGC!=%%~2"
echo(set /a PORTSH_ARGC+=1
echo(shift /2
echo(goto k_args
echo(:k_args_done
echo(goto :in_main
echo(:hp_cons
echo(set "hca=%%~1" ^& set "hcd=%%~2"
echo(set /a HN+=1
echo(^>%%HD%%\car%%HN%% echo^(!hca!#
echo(^>%%HD%%\cdr%%HN%% echo^(!hcd!#
echo(set "R=P:%%HN%%"
echo(goto :eof
echo(:hp_car
echo(set "hcp=%%~1"
echo(if "!hcp:~0,2!" NEQ "P:" set "R=NIL" ^& goto :eof
echo(set "hcp=!hcp:P:=!"
echo(set /p R=^<%%HD%%\car%%hcp%%
echo(set "R=!R:~0,-1!"
echo(goto :eof
echo(:hp_cdr
echo(set "hdp=%%~1"
echo(if "!hdp:~0,2!" NEQ "P:" set "R=NIL" ^& goto :eof
echo(set "hdp=!hdp:P:=!"
echo(set /p R=^<%%HD%%\cdr%%hdp%%
echo(set "R=!R:~0,-1!"
echo(goto :eof
echo(:done_boot
echo(exit /b 0
echo(
echo(rem feedfile ^(%%1=file %%2=#lines-to-skip^): prefix every line with [N] via
echo(rem `find /v /n ""` ^(so set/p never meets a blank line, which it can't tell from
echo(rem EOF^), then read each line RAW with set/p, discard the first %%2 ^(to skip the
echo(rem kernel's own text ahead of the baked-in payload^), and encode+drain the rest.
echo(:feedfile
echo(type "%%~1" ^| find /v /n "" ^> "%%TEMP%%\portsh_in_!HD!.txt"
echo(call reader.cmd ra %%2 ^< "%%TEMP%%\portsh_in_!HD!.txt"
echo(goto :eof
echo(
echo(
echo(rem ===================== heap ^(FILES: %%HD%%\car^<i^> / %%HD%%\cdr^<i^>^) =====================
echo(rem cmd var ops are O^(env-size^), so an env-var heap makes cons O^(N^^2^) to build and
echo(rem every car/cdr O^(heap^). The filesystem is O^(1^) by name, so each cell is two files
echo(rem car^<i^>/cdr^<i^> in %%HD%%. KEY: redirect targets are parsed BEFORE delayed expansion,
echo(rem so the PATH uses %%HD%%/%%HN%%/%%idx%% ^(immediate^); the value uses !..! ^(delayed,
echo(rem post-parse^) so operators ^(^& ^| ^< ^>^) and parens in a value never re-tokenize.
echo(rem Files don't degrade with heap size, so GC is non-critical here ^(po_gc neutralised^).
echo(rem PRE-increment ^(HN = the last USED cell^), matching compiled code's inline cons and rl_cons.
echo(rem The conventions MUST agree: under OSR mixed execution, interp and compiled conses interleave
echo(rem in one process, and a post-inc cons issued after a pre-inc one writes AT the other engine's
echo(rem newest live cell ^(that clobber turned ^(foldl + 0 ^(range 1 5^)^) into 1861 in the first
echo(rem progressive-warmer cold run^).
echo(:hp_cons
echo(set "hca=%%~1" ^& set "hcd=%%~2"
echo(set /a HN+=1
echo(^>%%HD%%\car%%HN%% echo^(!hca!#
echo(^>%%HD%%\cdr%%HN%% echo^(!hcd!#
echo(set "R=P:%%HN%%"
